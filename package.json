{
  "name": "containerghost",
  "version": "0.1.0",
  "description": "Local-first CLI that audits devcontainer, Docker Compose, Dockerfile, package scripts, and .env.example drift.",
  "type": "module",
  "bin": {
    "containerghost": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/tests/**/*.test.js",
    "smoke": "bash tests/smoke.sh",
    "validate": "bash scripts/validate.sh",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/containerghost.git"
  },
  "keywords": [
    "devcontainer",
    "docker-compose",
    "cli",
    "drift-detection",
    "developer-tools"
  ]
}
